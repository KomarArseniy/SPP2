# Скопируйте в .env и поменяйте значения. Файл .env в репозиторий не попадает.
APP_PORT=8080
MAIL_UI_PORT=8025

POSTGRES_USER=spp
POSTGRES_PASSWORD=spp
POSTGRES_DB=spp

# ОБЯЗАТЕЛЬНО смените для реального использования (длинная случайная строка):
JWT_SECRET=dev-only-secret-change-me-before-production

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345!
SEED_DEMO_USERS=true

LOG_LEVEL=info
